# CopilotKit + AWS Strands test suite — environment
#
# Copy this file to TWO places; the two processes read different subsets:
#   cp .env.example backend/.env
#   cp .env.example frontend/.env.local
#
# Never commit either copy. Both are already in .gitignore.

# ---------------------------------------------------------------------------
# Required — the model provider
# ---------------------------------------------------------------------------

# Your OpenAI API key. The Quickstart's `OpenAIModel(client_args={"api_key": …})`
# reads it, so the Python server needs it to answer anything at all.
#
# The Next process needs it too, but only for the /voice route: transcription
# goes through OpenAI Whisper. One key covers both jobs on this integration.
OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Optional — CopilotKit Intelligence (frontend / runtime)
# ---------------------------------------------------------------------------

# Project API key for CopilotKit Intelligence, which is what turns on persistent
# threads and the inspector. Set it in frontend/.env.local — all three runtime
# endpoints read it through frontend/src/lib/intelligence.ts.
#
# Get one with:  npx copilotkit login && npx copilotkit project select
# (writes INTELLIGENCE_API_KEY to .env), or copy it from the dashboard at
# https://dashboard.operations.copilotkit.ai
#
# SERVER-SIDE SECRET. Never give this a NEXT_PUBLIC_ prefix — that ships it to
# the browser.
#
# Leave it unset and every runtime falls back to SSE mode with an in-memory
# runner, which the Quickstart documents: chat still works, Threads and the
# Inspector stay locked, and the key is never read.
# INTELLIGENCE_API_KEY=cpk-...

# The CLIENT half of the same feature, and a different credential. The Threads
# Drawer page passes it inline as `publicLicenseKey="ck_pub_..."` on
# <CopilotKitProvider>; this repo reads it here instead.
#
# Threads need BOTH keys. With only the server one the drawer renders a locked
# view; with only this one useThreads returns an empty list. Neither doc page
# mentions the other credential.
#
# This one is genuinely public — it ships to the browser by design — so unlike
# INTELLIGENCE_API_KEY it does take the NEXT_PUBLIC_ prefix.
# NEXT_PUBLIC_COPILOTKIT_PUBLIC_LICENSE_KEY=ck_pub_...

# ---------------------------------------------------------------------------
# Optional — backend
# ---------------------------------------------------------------------------

# Which OpenAI model every agent runs on. Defaults to gpt-4o.
#
# The Quickstart's code block hardcodes `model_id="gpt-5.4"`, which does not
# resolve; its own callout says GPT-4o, and the two Shared State pages use
# gpt-4o. Set this to gpt-5.4 if you want to reproduce the published value and
# watch every agent fail. See README §9.
# MODEL_ID=gpt-4o

# Where uvicorn binds. Defaults to 0.0.0.0:8000.
# AGENT_HOST=0.0.0.0
# AGENT_PORT=8000

# Python logging level for the agent server. Defaults to INFO.
# LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Optional — frontend
# ---------------------------------------------------------------------------

# Where the Next runtime looks for the Python agent server. Defaults to
# http://localhost:8000. Each agent is mounted at `${AGENT_URL}/<agent-id>/`
# — the trailing slash matters, and `lib/agents.ts` adds it.
# AGENT_URL=http://localhost:8000

# Set to `off` to disable the CopilotKit inspector overlay everywhere.
# It is localhost-only by default.
# NEXT_PUBLIC_COPILOTKIT_INSPECTOR=off

# Set to true to opt out of CopilotKit's anonymous runtime telemetry.
# COPILOTKIT_TELEMETRY_DISABLED=true
